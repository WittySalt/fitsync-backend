<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.fitsync</groupId>
        <artifactId>fitsync-backend</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>..</relativePath>
    </parent>

    <!-- Project-wide coverage gate. JaCoCo has no aggregate check goal, so this
         module merges every module's jacoco.exec into its own target/jacoco.exec and
         copies every module's compiled classes into its own target/classes. The
         inherited report and coverage-check executions then run on the whole
         project, and here the check is hard: `mvn verify` fails when total line
         coverage is below jacoco.minimum.coverage. The dependencies below only make
         the reactor build this module last; nothing here is packaged or shipped. -->
    <artifactId>coverage-report</artifactId>
    <packaging>pom</packaging>
    <name>coverage-report</name>
    <description>FitSync aggregate coverage gate</description>

    <properties>
        <jacoco.halt.on.failure>true</jacoco.halt.on.failure>
        <!-- The copied classes are already analysed in their own modules. -->
        <spotbugs.skip>true</spotbugs.skip>
        <checkstyle.skip>true</checkstyle.skip>
        <sonar.skip>true</sonar.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>api-gateway</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>auth-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>user-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>workout-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>nutrition-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>analytics-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>recommendation-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>notification-service</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>event-contracts</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>persistence-support</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>media-support</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.fitsync</groupId>
            <artifactId>web-support</artifactId>
            <version>${project.version}</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>merge-module-coverage</id>
                        <phase>package</phase>
                        <goals><goal>merge</goal></goals>
                        <configuration>
                            <fileSets>
                                <fileSet>
                                    <directory>${project.basedir}/..</directory>
                                    <includes><include>*/target/jacoco.exec</include></includes>
                                    <excludes><exclude>coverage-report/**</exclude></excludes>
                                </fileSet>
                            </fileSets>
                            <destFile>${project.build.directory}/jacoco.exec</destFile>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-module-classes</id>
                        <phase>package</phase>
                        <goals><goal>copy-resources</goal></goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../api-gateway/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../auth-service/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../user-service/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../workout-service/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../nutrition-service/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../analytics-service/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../recommendation-service/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../notification-service/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../event-contracts/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../persistence-support/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../media-support/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/../web-support/target/classes</directory>
                                    <includes><include>**/*.class</include></includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
