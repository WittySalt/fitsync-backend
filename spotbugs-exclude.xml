<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter.
  Add patterns here only for known false positives with documented justification.
  Do NOT suppress real security findings without review.
-->
<FindBugsFilter>

    <!-- Generated code: Lombok-generated equals/hashCode triggers some patterns -->
    <Match>
        <Class name="~.*\.entity\..*"/>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>

    <!-- Spring @Configuration classes are instantiated by the container, not by new() -->
    <Match>
        <Class name="~.*\.config\..*"/>
        <Bug pattern="SING_SINGLETON_GETTER_NOT_SYNCHRONIZED"/>
    </Match>

    <!-- Test classes — lower bar for security patterns -->
    <Match>
        <Class name="~.*Test.*"/>
        <Bug category="SECURITY"/>
    </Match>

    <!-- Spring dependency injection on singleton components can trigger EI_EXPOSE_REP2 noise -->
    <Match>
        <Class name="com.fitsync.gateway.config.SecurityConfig"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.gateway.service.GatewayProxyServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Header filtering lower-cases fixed ASCII HTTP header names with Locale.ROOT only -->
    <Match>
        <Class name="com.fitsync.gateway.service.GatewayProxyServiceImpl"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!-- REST controllers are intentionally Spring endpoints -->
    <Match>
        <Class name="com.fitsync.gateway.controller.GatewayHealthController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.gateway.controller.GatewayProxyController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!-- Gateway proxy forwards authenticated bearer-token traffic and disables CSRF by design -->
    <Match>
        <Class name="com.fitsync.gateway.controller.GatewayProxyController"/>
        <Bug pattern="SPRING_CSRF_UNRESTRICTED_REQUEST_MAPPING"/>
    </Match>

    <!-- Spring dependency injection on auth-service security components can trigger EI_EXPOSE_REP2 noise -->
    <Match>
        <Class name="com.fitsync.backend.config.SecurityConfig"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.backend.messaging.SpringKafkaEventProducer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Auth controllers are intentional REST endpoints -->
    <Match>
        <Class name="com.fitsync.backend.controller.AuthController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.backend.controller.InternalOutboxController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.backend.controller.AuthAccountLifecycleController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.backend.controller.AuthSecurityController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <!-- Spring wiring and controllers in user-service -->
    <Match>
        <Class name="com.fitsync.user.config.SecurityConfig"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.user.controller.UserController"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.user.controller.UserController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.user.controller.InternalMessagingController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.user.messaging.SpringKafkaEventProducer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Spring wiring and controllers in nutrition-service -->
    <Match>
        <Class name="com.fitsync.nutrition.controller.NutritionController"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.nutrition.controller.NutritionController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.nutrition.controller.InternalMessagingController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.nutrition.service.NutritionServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Spring wiring, controllers, and JPA relationship noise in workout-service -->
    <Match>
        <Class name="com.fitsync.workout.controller.WorkoutController"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.workout.controller.WorkoutController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.workout.controller.InternalMessagingController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="~com\.fitsync\.workout\.entity\..*"/>
        <Bug pattern="EI_EXPOSE_REP"/>
    </Match>

    <Match>
        <Class name="~com\.fitsync\.workout\.entity\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Spring wiring and controllers in analytics-service -->
    <Match>
        <Class name="com.fitsync.analytics.controller.AnalyticsController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.controller.InternalAnalyticsController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.BodyMetricsRecordedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.DashboardSnapshotInitializer"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.GoalUpdatedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.MealDeletedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.MealLoggedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.MealNutritionProjectionService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.MealUpdatedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.WorkoutDeletedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.WorkoutLoggedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.WorkoutProjectionService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.WorkoutUpdatedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Shared Kafka listener error handler logs failed-record diagnostics (topic/key/eventType/
         exception message). Those values come from taint sources (ConsumerRecord accessors / payload
         JSON), so they ARE stripped of CR/LF inline before logging (CWE-117 mitigated). findsecbugs
         does not recognize the manual String.replace cleanser through String.valueOf and reports a
         false positive — the values are demonstrably sanitized at CommonKafkaListenerErrorConfiguration
         .logFailedRecord. -->
    <Match>
        <Class name="com.fitsync.web.config.CommonKafkaListenerErrorConfiguration"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- Account-deletion cascade consumers/projection services: Spring DI on singleton
         components triggers EI_EXPOSE_REP2 noise (same as the messaging consumers above). -->
    <Match>
        <Class name="com.fitsync.nutrition.messaging.AccountDeletedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.nutrition.messaging.AccountDeletionProjectionService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.AccountDeletedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.messaging.AccountDeletionProjectionService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Timezone projection added for timezone-aware analytics streaks (BE-AC-3). -->
    <Match>
        <Class name="com.fitsync.analytics.messaging.UserTimezoneProjectionService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Pre-existing analytics services storing injected repos/clock; same Spring-DI noise,
         previously missing from this filter (latent gap closed here). -->
    <Match>
        <Class name="com.fitsync.analytics.service.AnalyticsServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.service.AnalyticsRebuildServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.service.AnalyticsWeeklyRecapService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.analytics.service.AnalyticsDailyRollupUserProcessor"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- user-service: reconcile wiring added a UserService dependency to the internal
         controller; UserServiceImpl stores injected repos (pre-existing Spring-DI noise). -->
    <Match>
        <Class name="com.fitsync.user.controller.InternalMessagingController"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.user.service.UserServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- workout-service account-deletion cascade consumer/projection (Spring-DI noise). -->
    <Match>
        <Class name="com.fitsync.workout.messaging.AccountDeletedEventConsumerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.workout.messaging.AccountDeletionProjectionService"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
