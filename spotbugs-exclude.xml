    <!-- Shared Kafka listener error handler logs failed-record diagnostics (topic/key/eventType/
         exception message). Those values come from taint sources (ConsumerRecord accessors / payload
         JSON), so they ARE stripped of CR/LF inline before logging (CWE-117 mitigated). findsecbugs
         does not recognize the manual String.replace cleanser through String.valueOf and reports a
         false positive — the values are demonstrably sanitized at CommonKafkaListenerErrorConfiguration
         .logFailedRecord. -->
    <Match>
        <Class name="com.fitsync.web.config.CommonKafkaListenerErrorConfiguration"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- AnalyticsCacheInvalidationService logs cache-eviction diagnostics: cacheName is a fixed
         constant, userId is a UUID, and the exception message is run through sanitizeForLog (strips
         CR/LF, CWE-117 mitigated). findsecbugs does not recognize the inline sanitizer and reports a
         false positive (same as CommonKafkaListenerErrorConfiguration above). -->
    <Match>
        <Class name="com.fitsync.analytics.service.AnalyticsCacheInvalidationService"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
    </Match>

    <!-- UsdaSrLegacyImportRunner logs the import directory + a summary of ints. The directory is
