         flags the non-constant argument (false positive), so exclude it for this class only. -->
    <Match>
        <Class name="com.fitsync.nutrition.service.ingest.UsdaSrLegacyImportRunner"/>
        <Bug pattern="CRLF_INJECTION_LOGS"/>
