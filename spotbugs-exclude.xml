<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusion filter.
  Add patterns here only for known false positives with documented justification.
  Do NOT suppress real security findings without review.
-->
<FindBugsFilter>

    <!-- Generated code: Lombok-generated equals/hashCode triggers some patterns -->
    <Match>
        <Class name="~.*\.entity\..*"/>
        <Bug pattern="EQ_DOESNT_OVERRIDE_EQUALS"/>
    </Match>

    <!-- Spring @Configuration classes are instantiated by the container, not by new() -->
    <Match>
        <Class name="~.*\.config\..*"/>
        <Bug pattern="SING_SINGLETON_GETTER_NOT_SYNCHRONIZED"/>
    </Match>

    <!-- Test classes — lower bar for security patterns -->
    <Match>
        <Class name="~.*Test.*"/>
        <Bug category="SECURITY"/>
    </Match>

    <!-- Spring dependency injection on singleton components can trigger EI_EXPOSE_REP2 noise -->
    <Match>
        <Class name="com.fitsync.gateway.config.SecurityConfig"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <Match>
        <Class name="com.fitsync.gateway.service.GatewayProxyServiceImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Header filtering lower-cases fixed ASCII HTTP header names with Locale.ROOT only -->
    <Match>
        <Class name="com.fitsync.gateway.service.GatewayProxyServiceImpl"/>
        <Bug pattern="IMPROPER_UNICODE"/>
    </Match>

    <!-- REST controllers are intentionally Spring endpoints -->
    <Match>
        <Class name="com.fitsync.gateway.controller.GatewayHealthController"/>
        <Bug pattern="SPRING_ENDPOINT"/>
    </Match>

    <Match>
        <Class name="com.fitsync.gateway.controller.GatewayProxyController"/>
