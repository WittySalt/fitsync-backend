# ── FitSync production env (copy to .env on the EC2 host; never commit .env) ──
# Usage: docker compose -f docker-compose.prod.yml --env-file .env up -d

# ── Image source (Amazon ECR) ────────────────────────────────────────────────
# Leave ECR_REGISTRY EMPTY for a local dry-run (uses the locally-built
# fitsync-<service> images). Set it to your ECR host for the real EC2 deploy.
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com
IMAGE_TAG=latest

# ── Database (Amazon RDS for PostgreSQL) ─────────────────────────────────────
# One database "fitsync"; each service owns a schema (auth / user_domain /
# workout / nutrition / analytics) created by Flyway. The DB user needs
# CREATE on the database so Flyway can create those schemas on first run.
DB_URL=jdbc:postgresql://fitsync-prod.xxxxxxxx.ap-southeast-1.rds.amazonaws.com:5432/fitsync
DB_USERNAME=fitsync
DB_PASSWORD=__change_me__

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# JWT_SECRET must be a long random string. JWT_EXPIRATION is an ISO-8601 Duration.
JWT_SECRET=__change_me_long_random_secret__
JWT_EXPIRATION=PT2H

# ── Redis (bundled container by default; point at ElastiCache to upgrade) ─────
REDIS_HOST=redis
REDIS_PORT=6379
# analytics-service only — leave cache 'simple' for phase 1, or 'redis' to use it
SPRING_CACHE_TYPE=simple
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ── Kafka (disabled in phase 1 — no MSK) ─────────────────────────────────────
KAFKA_ENABLED=false

# ── Cognito (optional; gateway + auth verify Cognito tokens when enabled) ────
COGNITO_ENABLED=false
COGNITO_ISSUER_URI=
COGNITO_AUDIENCE=
COGNITO_JWK_SET_URI=
COGNITO_PRINCIPAL_CLAIM=username

# ── nginx / TLS ──────────────────────────────────────────────────────────────
NGINX_SERVER_NAME=api.example.com
NGINX_CERT_NAME=api.example.com
