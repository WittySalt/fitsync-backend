# ── FitSync production env (copy to .env on the EC2 host; never commit .env) ──
# Usage: docker compose -f docker-compose.prod.yml --env-file .env up -d

# ── Image source (Amazon ECR) ────────────────────────────────────────────────
# Leave ECR_REGISTRY EMPTY for a local dry-run (uses the locally-built
# fitsync-<service> images). Set it to your ECR host for the real EC2 deploy.
ECR_REGISTRY=123456789012.dkr.ecr.ap-southeast-1.amazonaws.com
IMAGE_TAG=latest

# ── Database (Amazon RDS for PostgreSQL) ─────────────────────────────────────
# One database "fitsync"; each service owns a schema (auth / user_domain /
# workout / nutrition / analytics) created by Flyway. The DB user needs
# CREATE on the database so Flyway can create those schemas on first run.
DB_URL=jdbc:postgresql://fitsync-prod.xxxxxxxx.ap-southeast-1.rds.amazonaws.com:5432/fitsync
DB_USERNAME=fitsync
DB_PASSWORD=__change_me__

# ── Auth / JWT ───────────────────────────────────────────────────────────────
# JWT_SECRET must be a long random string. JWT_EXPIRATION is an ISO-8601 Duration.
JWT_SECRET=__change_me_long_random_secret__
JWT_EXPIRATION=PT2H

# ── Redis (bundled container by default; point at ElastiCache to upgrade) ─────
REDIS_HOST=redis
REDIS_PORT=6379
# analytics-service only — leave cache 'simple' for phase 1, or 'redis' to use it
SPRING_CACHE_TYPE=simple
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=

# ── Kafka (disabled in phase 1 — no MSK) ─────────────────────────────────────
KAFKA_ENABLED=false

# ── Cognito (optional; gateway + auth verify Cognito tokens when enabled) ────
COGNITO_ENABLED=false
COGNITO_ISSUER_URI=
COGNITO_AUDIENCE=
COGNITO_JWK_SET_URI=
COGNITO_PRINCIPAL_CLAIM=username

# ── Media / images (Amazon S3) ───────────────────────────────────────────────
# Object storage for workout exercise images (catalog import) AND user avatars.
# Same media-support S3 client in both services — locally it points at the MinIO
# emulator, in prod at a real S3 bucket. Leave these blank ONLY if you don't need
# images: the services still boot, but every avatar/exercise image stays broken.
#   - ENDPOINT       : the S3 API endpoint the SDK WRITES through (path-style).
#   - PUBLIC_BASE_URL: the browser-reachable base the stored URL is built from at
#                      upload time. MUST be https (the SPA is https, so http image
#                      URLs are blocked as mixed content). Changing it later does
#                      NOT rewrite already-stored rows.
#   - ACCESS/SECRET  : IAM user key with s3:PutObject on the bucket (media-support
#                      uses STATIC keys, not the EC2 instance role).
FITSYNC_MEDIA_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
FITSYNC_MEDIA_REGION=ap-southeast-1
FITSYNC_MEDIA_ACCESS_KEY=__change_me__
FITSYNC_MEDIA_SECRET_KEY=__change_me__
FITSYNC_MEDIA_BUCKET=fitsync-media
FITSYNC_MEDIA_PUBLIC_BASE_URL=https://fitsync-media.s3.ap-southeast-1.amazonaws.com
# Host dir holding the free-exercise-db images, mounted read-only into
# workout-service. Populate it once with scripts/fetch-free-exercise-db-images.sh
# BEFORE first boot, or the catalog imports metadata with no images.
FREE_EXERCISE_DB_IMAGES_DIR=/opt/fitsync/free-exercise-db/exercises

# ── nginx / TLS ──────────────────────────────────────────────────────────────
NGINX_SERVER_NAME=api.example.com
NGINX_CERT_NAME=api.example.com
