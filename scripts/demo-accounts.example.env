# Copy to scripts/demo-accounts.env (git-ignored) and put the three real addresses there.
# demo-reseed.ps1 reads demo-accounts.env when it exists, otherwise this file.
# steady   : four sessions a week, on track, the account for most of the recording
# drifting : habits slipping, shows what the coach says when a week goes quiet
# fresh    : onboarded only, no history, for the empty states
DEMO_STEADY_EMAIL=steady@example.com
DEMO_DRIFTING_EMAIL=drifting@example.com
DEMO_FRESH_EMAIL=fresh@example.com
