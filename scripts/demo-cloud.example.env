# Copy to scripts/demo-cloud.env (git-ignored) and fill in the real values.
# demo-reseed-cloud.ps1 reads it. The hosts have no SSH port open: the script reaches them with
# ssh over SSM Session Manager, so it needs the instance id (`terraform output -raw ec2_instance_id`
# in that workspace), not an address. Keys are the SSH private key paths (~ is expanded); ssh over
# SSM still logs in with them. The app secret ids name the Secrets Manager entry that holds db_host,
# db_port, db_name and db_master_secret_arn for that environment.
STAGING_INSTANCE_ID=i-0123456789abcdef0
STAGING_SSH_KEY=~/.ssh/fitsync-staging-deploy
STAGING_APP_SECRET_ID=fitsync-staging/app
PROD_INSTANCE_ID=i-0123456789abcdef1
PROD_SSH_KEY=~/.ssh/fitsync-prod-deploy
PROD_APP_SECRET_ID=fitsync-prod/app
# Optional: the AWS CLI profile that starts the SSM session (empty = the default credentials).
STAGING_AWS_PROFILE=
PROD_AWS_PROFILE=
# Optional: the site address, only used in the printed coach-eval command.
STAGING_BASE_URL=
PROD_BASE_URL=
