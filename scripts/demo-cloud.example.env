# Copy to scripts/demo-cloud.env (git-ignored) and fill in the real values.
# demo-reseed-cloud.ps1 reads it. Hosts are the EC2 public addresses; keys are SSH private key
# paths (~ is expanded). The app secret ids name the Secrets Manager entry that holds db_host,
# db_port, db_name and db_master_secret_arn for that environment.
STAGING_HOST=staging.example.com
STAGING_SSH_KEY=~/.ssh/fitsync-staging-deploy
STAGING_APP_SECRET_ID=fitsync-staging/app
PROD_HOST=prod.example.com
PROD_SSH_KEY=~/.ssh/fitsync-prod-deploy
PROD_APP_SECRET_ID=fitsync-prod/app
# Optional: the site address, only used in the printed coach-eval command.
STAGING_BASE_URL=
PROD_BASE_URL=
